SchemaVersion: 1
Nodes:
  ChildNodes:
    Node0:
      DependencyIndex: 0
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |-
            // Witch's Lab glass (premultiplied alpha, two-sided, no depth write).
            // Vertex colour: rgb = faint tint, a = thickness (rim / base thicker = more opaque edge).
            output_vec4 result;

            // ---- Witch's Lab shared lighting: a bright kitchen "studio" in world space.
            // Two tall window strips behind the viewer + a soft ceiling light, a warm
            // floor bounce. Used for every reflection so glass, liquid and metal agree.
            vec3 wlStudio(vec3 R)
            {
                float up = R.y;
                vec3 sky = mix(vec3(0.10, 0.09, 0.08), vec3(0.40, 0.39, 0.37), smoothstep(-0.35, 0.85, up));
                float az = atan(R.x, R.z);
                // window strips only reflect on near-vertical walls: no unstable azimuth near the zenith
                float band = smoothstep(-0.15, 0.10, up) * (1.0 - smoothstep(0.32, 0.55, up));
                float s1 = (1.0 - smoothstep(0.035, 0.11, abs(az + 0.62))) * band;
                float s2 = (1.0 - smoothstep(0.02, 0.06, abs(az - 0.78))) * band;
                float s3 = (1.0 - smoothstep(0.05, 0.16, abs(abs(az) - 2.6))) * band * 0.5;
                float top = smoothstep(0.80, 0.97, up);
                return sky + vec3(1.0, 0.92, 0.80) * (s1 * 1.5 + s2 * 0.55 + s3 * 0.4 + top * 0.45);
            }
            float wlLuma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
            float wlHash(vec3 p)
            {
                p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
                p *= 17.0;
                return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
            }
            float wlNoise(vec3 x)
            {
                vec3 i = floor(x);
                vec3 f = fract(x);
                f = f * f * (3.0 - 2.0 * f);
                return mix(mix(mix(wlHash(i + vec3(0.0, 0.0, 0.0)), wlHash(i + vec3(1.0, 0.0, 0.0)), f.x),
                               mix(wlHash(i + vec3(0.0, 1.0, 0.0)), wlHash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
                           mix(mix(wlHash(i + vec3(0.0, 0.0, 1.0)), wlHash(i + vec3(1.0, 0.0, 1.0)), f.x),
                               mix(wlHash(i + vec3(0.0, 1.0, 1.0)), wlHash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y), f.z);
            }

            // soft shoulder: highlights roll off instead of clipping to pure white
            vec3 wlTone(vec3 c) { return c * (1.0 + c * 0.12) / (1.0 + c); }

            void main()
            {
                vec3 P = system.getSurfacePositionWorldSpace();
                vec3 N = normalize(system.getSurfaceNormalWorldSpace());
                vec3 V = normalize(system.getCameraPosition() - P);
                if (dot(N, V) < 0.0) N = -N;
                vec4 vc = system.getSurfaceColor();
                float ndv = clamp(dot(N, V), 0.0, 1.0);
                float F = 0.04 + 0.96 * pow(1.0 - ndv, 5.0);
                vec3 R = reflect(-V, N);
                vec3 env = wlStudio(R);
                // silhouette darkening + bright fresnel rim = how real glass reads
                float edge = pow(1.0 - ndv, 2.4) * vc.a;
                vec3 spec = wlTone(env * (F * 0.95 + 0.02) * (0.6 + 0.4 * vc.a));
                vec3 body = vc.rgb * (0.03 + edge * 0.22);
                float a = clamp(0.025 + edge * 0.34 + wlLuma(spec) * 0.4, 0.0, 0.78);
                result = vec4(body + spec, a);
            }
        CustomCodeNodeAsset:
          ClassType1: REFUID
          String: ""
        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: WL_Glass_v3
        UseExternalFile:
          Variable: false
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        result:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: -59
